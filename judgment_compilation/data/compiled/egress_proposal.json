provenance":["AC-6 Control"],"semantic_kind":"SCENARIO_DERIVATION","support":["source:AC-6 Control","statement:0","statement:1","statement:2","statement:3"],"text":"For Employee A and Employee A's administrator account at Business A, the supplied continued administrator-access facts select AC-6 for review of authorized and necessary access. Necessity and authorization remain unverified.","type":"DETERMINISTIC_DERIVATION","value":true},{"id":"source:PS-4(a)","provenance":["PS-4(a)"],"support":[],"text":"Disable system access within [Assignment: organization-defined time period];","type":"SOURCE_BOUND"},{"id":"source:PS-4(b)","provenance":["PS-4(b)"],"support":[],"text":"Terminate or revoke any authenticators and credentials associated with the individual;","type":"SOURCE_BOUND"},{"arguments":{"account":"account-a","business":"org-a","employee":"person-a"},"id":"derived:f62bf50c14a8b4a686748557ab5f6c0cf222555fb1a70b7f57500223487649cc","predicate":"personnel_termination_relevance","provenance":["PS-4(a)","PS-4(b)"],"semantic_kind":"SCENARIO_DERIVATION","support":["source:PS-4(a)","source:PS-4(b)","statement:0","statement:1","statement:3"],"text":"For Employee A and Employee A's administrator account at Business A, the supplied termination and continued-access facts select PS-4(a)-(b) for review of access disabling and credential revocation. The applicable time period and responsible organization remain unresolved.","type":"DETERMINISTIC_DERIVATION","value":true},{"arguments":{"account":"account-a","business":"org-a","employee":"person-a"},"id":"derived:2c7dc677a1e1a9342f631819cdfa3fa009f3995958ec6e0f187770abcddff2dd","predicate":"termination_admin_access_issue","provenance":["AC-2(l)","AC-6 Control","PS-4(a)","PS-4(b)"],"semantic_kind":"SCENARIO_DERIVATION","support":["derived:5379b3e1af0970ef54bfdf1f2396c6c8d2a5c7f2534c581fe94f2497f4e848c8","derived:68f10bb4735e4f5e19593cbb630bc758f2926673d85e02a2ac21c8ffd4e3b507","derived:f62bf50c14a8b4a686748557ab5f6c0cf222555fb1a70b7f57500223487649cc","source:AC-2(l)","source:AC-6 Control","source:PS-4(a)","source:PS-4(b)"],"text":"The supplied facts about Employee A's continued administrator access through Employee A's administrator account after employment at Business A ended jointly select AC-2, AC-6, and PS-4 for account-management, least-privilege, and personnel-termination review. This is a source-supported review finding; it does not establish control applicability, a violation, compliance status, responsibility, or action authority.","type":"DETERMINISTIC_DERIVATION","value":true},{"binding":{"account":"account-a","business":"org-b","employee":"person-a"},"id":"residual:05929cb565ebb7107af52b7163419cfa35c2d506ce1e1329e9f852cd8bfe2342:account_management_relevance","provenance":[],"reason":"UNRESOLVED","residuals":[{"arguments":{"business":"org-b","employee":"person-a"},"predicate":"employment_terminated","premise":0,"reason":"MISSING_FACT","type":"UNRESOLVED"}],"step_id":"account_management_relevance","support":[],"text":"Supply consistent termination, account identity and continued-access facts for this exact entity binding.","type":"UNRESOLVED"},{"binding":{"account":"account-a","business":"org-b","employee":"person-a"},"id":"residual:05929cb565ebb7107af52b7163419cfa35c2d506ce1e1329e9f852cd8bfe2342:least_privilege_relevance","provenance":[],"reason":"UNRESOLVED","residuals":[{"arguments":{"business":"org-b","employee":"person-a"},"predicate":"employment_terminated","premise":0,"reason":"MISSING_FACT","type":"UNRESOLVED"}],"step_id":"least_privilege_relevance","support":[],"text":"Supply consistent termination, account identity, privilege and continued-access facts for this exact entity binding.","type":"UNRESOLVED"},{"binding":{"account":"account-a","business":"org-b","employee":"person-a"},"id":"residual:05929cb565ebb7107af52b7163419cfa35c2d506ce1e1329e9f852cd8bfe2342:personnel_termination_relevance","provenance":[],"reason":"UNRESOLVED","residuals":[{"arguments":{"business":"org-b","employee":"person-a"},"predicate":"employment_terminated","premise":0,"reason":"MISSING_FACT","type":"UNRESOLVED"}],"step_id":"personnel_termination_relevance","support":[],"text":"Supply consistent termination, account identity and continued-access facts for this exact entity binding.","type":"UNRESOLVED"},{"binding":{"account":"account-a","business":"org-b","employee":"person-a"},"id":"residual:05929cb565ebb7107af52b7163419cfa35c2d506ce1e1329e9f852cd8bfe2342:termination_admin_access_issue","provenance":[],"reason":"BLOCKED","residuals":[{"reason":"DEPENDENCY_UNRESOLVED_OR_NOT_APPLICABLE","steps":["account_management_relevance","least_privilege_relevance","personnel_termination_relevance"],"type":"UNRESOLVED"}],"step_id":"termination_admin_access_issue","support":[],"text":"A required dependency remains unresolved or is not applicable.","type":"UNRESOLVED"},{"id":"required-residual:0","provenance":[],"reason":"RESPONSIBILITY_AND_TERMINATION_BINDINGS_UNRESOLVED","support":[],"text":"The system cannot determine which scenario organization is responsible for revocation until account ownership, contractual responsibility, and the organization-defined termination procedure and time period are provided.","type":"UNRESOLVED"},{"id":"required-residual:1","provenance":[],"reason":"EVIDENCE_AND_AUTHORITY_CEILING","support":[],"text":"Authorization, assigned organizational tasks, and evidence of implementation remain unverified. No compliance determination or external action is authorized.","type":"UNRESOLVED"}],"support_graph":[{"from":"source:AC-2(l)","relation":"SUPPORTS","to":"derived:68f10bb4735e4f5e19593cbb630bc758f2926673d85e02a2ac21c8ffd4e3b507"},{"from":"statement:0","relation":"SUPPORTS","to":"derived:68f10bb4735e4f5e19593cbb630bc758f2926673d85e02a2ac21c8ffd4e3b507"},{"from":"statement:1","relation":"SUPPORTS","to":"derived:68f10bb4735e4f5e19593cbb630bc758f2926673d85e02a2ac21c8ffd4e3b507"},{"from":"statement:3","relation":"SUPPORTS","to":"derived:68f10bb4735e4f5e1